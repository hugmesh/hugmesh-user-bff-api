<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- The org metapom — consolidates the Spring Boot 4.0.7 / Java 25 reactive BFF
       baseline (WebFlux + Casdoor OAuth2 resource server + R2DBC/Liquibase +
       SpringDoc), the shared <dependencies>, dependencyManagement (hugmesh-commons,
       AWS SDK BOM, resilience4j, springdoc), pluginManagement (compiler / surefire
       bytebuddy flag / spring-boot / native) and the GitLab Maven publishing wiring.
       hugmesh-parent is itself a child of spring-boot-starter-parent:4.0.7, so the
       Spring Boot dependency + plugin management is inherited TRANSITIVELY. -->
  <parent>
    <groupId>systems.hugmesh</groupId>
    <artifactId>hugmesh-parent</artifactId>
    <version>2.8.0</version>
    <relativePath/>
  </parent>

  <groupId>systems.hugmesh</groupId>
  <!-- NO -api suffix in the artifactId (mirrors admin-bff): -api is only in the
       repo/service/image name. -->
  <artifactId>user-bff</artifactId>
  <version>0.2.0</version>
  <properties>
    <!-- java.version (25), encoding, the hugmesh-commons version and the springdoc
         version are all inherited from hugmesh-parent. ONLY the repo-specific pins
         (icu4j / commons-text) stay below on the dependencies themselves. -->
  </properties>
  <dependencies>
    <!-- The shared, canonical HugMesh security/tenancy/config/web building blocks
         (Casdoor JWT authorities, issuer->domain DomainRegistry, Roles helpers, the
         config-gated multi-issuer TenancyResourceServerConfig, the static-utility
         tenancy.DomainScope, the BFF web.ApiException). Version is MANAGED by
         hugmesh-parent's dependencyManagement, so NO <version> here. This replaces
         this repo's deleted local copies of security.{Roles,DomainRegistry,DomainScope,
         CasdoorAuthorities}, config.TenancyResourceServerConfig and web.ApiException. -->
    <dependency>
      <groupId>systems.hugmesh</groupId>
      <artifactId>hugmesh-commons</artifactId>
    </dependency>

    <!-- hugmesh-commons TEST-JAR — provides the shared Testcontainers Postgres
         base (systems.hugmesh.commons.testsupport.PostgresTestSupport) that
         full-context @SpringBootTest tests extend under Spring Boot 4. Carries an
         EXPLICIT <version>2.1.0</version>: hugmesh-parent's dependencyManagement
         entry for hugmesh-commons has NO <classifier>, so it manages only the
         MAIN classifier — a tests-classifier dependency does NOT inherit a version
         from it and must pin one here. 2.1.0 is the REAL published commons artifact
         coordinate (commons' own project <version> on main is 2.1.0; 2.8.0 is the
         PARENT version and was never published as a commons jar — it 404s on a
         clean-CI build). 2.1.0 carries current content under commons' overwrite
         publish model and is byte-identical to the relabeled 2.8.0. -->
    <dependency>
      <groupId>systems.hugmesh</groupId>
      <artifactId>hugmesh-commons</artifactId>
      <version>2.1.0</version>
      <classifier>tests</classifier>
      <scope>test</scope>
    </dependency>

    <!-- The shared SSO / Casdoor-OIDC building blocks: the OidcExchangeClient (PKCE
         code->token exchange + refresh against Casdoor), the at-rest BffCustodyCipher
         (AES-256-GCM, inert + fail-closed when its key is blank), the opaque-bff_-cookie
         SessionCookieService / SessionCookieWebFilter, the X-Internal-Token guard
         (InternalTokenWebFilter), the InternalSurfaceBootGuard and the canonical
         reserved.ReservedNames (this repo's local profile.ReservedNames dup is deleted
         in favour of it). Unlike hugmesh-commons, auth-core is NOT parent-managed —
         so this dependency carries an EXPLICIT <version>. PINNED to 2.4.1 (2.4.0 was
         the HugMesh-rename coordinate, bumped from the pre-rebrand 2.3.3 pin; 2.4.1
         adds the canonical reserved-prefix revision 7-9 sync — hmdm / attest plus the
         Character Forge track's character-forge / games-character-forge /
         games-shadows-of-the-net — on top of the revision 4-6 labels 2.3.3 carried):
         auth-core's ReservedNames is the runtime reserved-username enforcement this
         BFF's ProfileService/UsernameSkeleton username guard consumes directly, so
         with this pin those five labels are ALSO rejected as a clean service-layer
         400, with the 021 DB CHECK (ck_user_profile_vanity_username_reserved) as the
         defence-in-depth backstop beneath it.
         RELEASE NOTE: 2.4.1 exists on hugmesh-auth-core branch
         feat/character-forge-reserved-labels and is NOT yet published to the
         registry — until it is released, CI resolution of this pin FAILS (local
         builds work via a locally-installed ./mvnw install of that branch). -->
    <dependency>
      <groupId>systems.hugmesh</groupId>
      <artifactId>hugmesh-auth-core</artifactId>
      <version>2.4.1</version>
    </dependency>

    <!-- ============================================================================
         The core reactive BFF stack (webflux / actuator / security /
         oauth2-resource-server / validation), the data-access stack (data-r2dbc /
         r2dbc-postgresql / liquibase-core / spring-jdbc / postgresql), springdoc, and
         the whole test stack (spring-boot-starter-test / reactor-test /
         spring-security-test / r2dbc-h2 / h2) are INHERITED from hugmesh-parent's
         common <dependencies>. They were removed here to de-duplicate. ONLY the
         repo-specific dependencies below remain.
         ============================================================================ -->

    <!-- ICU4J — Unicode confusable/skeleton folding (SpoofChecker.getSkeleton +
         RESTRICTION_LEVEL/CONFUSABLE) for the username/displayName impersonation
         guard. PINNED to an EXACT version: ICU confusable skeletons are NOT stable
         across releases, so the version is a deliberate, audited pin — never let it
         float. The skeleton produced here is a RECOMPUTABLE CACHE used only for
         defence-in-depth rejection at this layer; it is NEVER a unique DB identity
         (the exact-username UNIQUE + the 004 vanity_username CHECK remain the real
         DB backstop). Same pin used by the federation/actions/admin-bff copies. -->
    <dependency>
      <groupId>com.ibm.icu</groupId>
      <artifactId>icu4j</artifactId>
      <version>77.1</version>
    </dependency>
    <!-- commons-text — Damerau/Levenshtein edit-distance for the (reserved-set only)
         typo-squat tier of the confusable guard. -->
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-text</artifactId>
      <version>1.13.0</version>
    </dependency>
  </dependencies>
  <build><plugins>
    <!-- The spring-boot, native and surefire (bytebuddy-experimental argLine)
         plugins are configured in hugmesh-parent's pluginManagement; declaring
         them here (no config) binds the managed config. The native plugin is bound
         so `./mvnw -Pnative native:compile` works; spring-boot repackages the app. -->
    <plugin>
      <groupId>org.graalvm.buildtools</groupId>
      <artifactId>native-maven-plugin</artifactId>
    </plugin>
    <plugin>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-maven-plugin</artifactId>
    </plugin>
  </plugins></build>
  <profiles>
    <!-- Native build: `./mvnw -Pnative native:compile` produces a GraalVM
         binary. The `native` profile (process-aot + reachability metadata) is
         defined by spring-boot-starter-parent; this thin local profile mirrors
         admin-bff so the same `-Pnative` invocation works. -->
    <profile>
      <id>native</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.graalvm.buildtools</groupId>
            <artifactId>native-maven-plugin</artifactId>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
