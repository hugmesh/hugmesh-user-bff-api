<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!--
      User BFF schema. Liquibase runs over a JDBC datasource (Liquibase has no
      R2DBC runner); all runtime data access goes through R2DBC. Every table is
      owner-keyed by the Casdoor JWT subject (user_id) — a user only ever touches
      their own rows (owner-enforcement lives in the service layer too).

        001 — user_profile     (own profile: gender/pronouns/tz/displayName/visibility/vanity)
        002 — user_preference  (own per-key preferences incl. home-guide-dismissed)
        003 — user_block       (own self-blocks pushed to Matrix/Mastodon/internal)
        004 — user_profile.vanity_username + reserved-name CHECK (vanity collision guard)
        005 — enum/domain CHECK constraints (DB parity for the API-enforced
              user_profile.visibility + user_block.platform vocabularies)
        006 — self_silence (self-service visibility hide; NOT a ban — zero Casdoor
              roles / access_suspension / revocation keys; @Scheduled auto-clear)
        007 — media_poison_decision (server-owned AI-cloak decision + outcome for
              the BFF media-proxy: audit + badge + repost source of truth)
        008 — user_profile.screen_reader_name (ASCII-only a11y aria-label name;
              defaults from an ASCII display_name, prompted when display_name is
              non-ASCII)
        009 — connected_client_audit (owner-scoped record of the user's OAuth apps /
              device sessions on the homeservers + revoke audit)
    -->

    <include file="db/changelog/001-user-profile.xml"/>
    <include file="db/changelog/002-user-preference.xml"/>
    <include file="db/changelog/003-user-block.xml"/>
    <include file="db/changelog/004-vanity-username-reserved.xml"/>
    <include file="db/changelog/005-enum-check-constraints.xml"/>
    <include file="db/changelog/006-self-silence.xml"/>
    <include file="db/changelog/007-media-poison-decision.xml"/>
    <include file="db/changelog/008-user-profile-screen-reader-name.xml"/>
    <include file="db/changelog/009-connected-client-audit.xml"/>
</databaseChangeLog>
