<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!--
        user_profile.vanity_username + reserved-name CHECK.

        The profile is keyed by user_id = Casdoor SUBJECT (an opaque id), NOT the
        username. But the profile carries the VANITY INTENT (vanity_subdomain_enabled):
        when a user enables their vanity subdomain, their PUBLIC profile is served at
        <username>.snapdragon.systems — so the USERNAME (the Casdoor preferred_username
        claim) becomes a DNS label and must not collide with a dedicated app route.

        We therefore add a NORMALIZED vanity_username column that MIRRORS the Casdoor
        username (lower-cased) ONLY when vanity is enabled, and is NULL otherwise. The
        ProfileService writes it from the JWT's preferred_username claim (see
        ProfileController). The CHECK below is the DB-LEVEL backstop for the
        service-layer validation: a non-null vanity_username may not be a reserved
        label. The forbidden list is generated from the canonical
        ReservedNames.RESERVED_LABELS set — the SAME list the federation serving layer
        + its 016 reserved-slug CHECK use (canonical source: the fe-/be-gateway routes
        + reserved subdomains + the snapdragon.games route prefixes). lower() makes the
        constraint case-insensitive, matching the util. Keep this list in sync with
        ReservedNames if that set changes.

        Portability: plain ANSI `vanity_username IS NULL OR lower(vanity_username)
        NOT IN (...)` — runs identically on production Postgres AND the H2
        PostgreSQL-compat slice DB (TestDatabaseConfig).
    -->

    <changeSet id="004-1-user-profile-vanity-username" author="snapdragon">
        <addColumn tableName="user_profile">
            <!-- Normalized (lower-cased) Casdoor username, set ONLY when vanity is
                 enabled; NULL when disabled. Matches the firstLabel of the vanity
                 host the federation API resolves. -->
            <column name="vanity_username" type="varchar(255)"/>
        </addColumn>
    </changeSet>

    <changeSet id="004-2-user-profile-vanity-username-reserved-check" author="snapdragon">
        <sql>
            ALTER TABLE user_profile
                ADD CONSTRAINT ck_user_profile_vanity_username_reserved
                CHECK (
                    vanity_username IS NULL
                    OR lower(vanity_username) NOT IN (
                        '_fragments', '_matrix', '_remotes', 'actuator', 'admin', 'api',
                        'api-docs', 'apidocs', 'argocd', 'assets', 'auth', 'banned', 'be',
                        'bff', 'docs', 'favicon', 'fragments', 'games', 'games-dodecahedron',
                        'games-rpg-maker', 'games-three-wizards', 'games-vn-maker', 'gitlab',
                        'gm', 'headscale', 'health', 'healthz', 'help', 'id', 'login',
                        'logout', 'mastodon', 'matrix', 'metrics', 'mod', 'oauth', 'oauth2',
                        'pki', 'play', 'producer', 'producer-registration', 'public',
                        'publisher', 'registration', 'registry', 'robots', 'root', 'scale',
                        'sitemap', 'social', 'static', 'status', 'support', 'user', 'users',
                        'vault', 'wasm', 'wasm-fragment', 'well-known', 'www'
                    )
                )
        </sql>
        <rollback>
            ALTER TABLE user_profile
                DROP CONSTRAINT ck_user_profile_vanity_username_reserved
        </rollback>
    </changeSet>

</databaseChangeLog>
