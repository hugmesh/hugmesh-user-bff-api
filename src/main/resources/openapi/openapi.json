{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "snapdragon-user-bff-api",
    "description" : "User BFF API (/bff/user/**) — owner-scoped profile, home-guide preferences, federation-bundle cards, self-blocking, and instance-block recommendation. Every endpoint is keyed to the caller's Casdoor JWT subject.",
    "version" : "0.1.0"
  },
  "servers" : [ {
    "url" : ""
  } ],
  "tags" : [ {
    "name" : "Mastodon proxy (D6)",
    "description" : "Owner-scoped Mastodon reverse-proxy; injects the server-held homeserver-native token. Ships dark behind app.hs-token.enabled."
  }, {
    "name" : "Home guide",
    "description" : "Per-user home/getting-started guide dismissal (owner = JWT subject)."
  }, {
    "name" : "Media-cloak",
    "description" : "Poison-before-ingest media proxy (owner = JWT subject). Best-effort AI-cloak — 'AI-cloak applied', never 'protected' unless the round-trip survival gate passes."
  }, {
    "name" : "Profile",
    "description" : "The caller's OWN profile (owner = JWT subject). Password/email go to the Casdoor IdP."
  }, {
    "name" : "Self-block",
    "description" : "The caller's OWN blocks (owner = JWT subject) + instance-block recommendation."
  }, {
    "name" : "Notification preferences",
    "description" : "Per-category notification preferences (owner = JWT subject, domain-scoped). account-restriction is forced-on / un-silenceable."
  }, {
    "name" : "Cards",
    "description" : "The caller's OWN federation bundles (owner = JWT subject), via snapdragon-federation-api."
  }, {
    "name" : "User preferences",
    "description" : "Durable per-user UI preferences (owner = JWT subject, domain-scoped). Carries media.poison.default — the per-user AI-poison default the compose toggle persists."
  }, {
    "name" : "Matrix proxy (D6)",
    "description" : "Owner-scoped Matrix reverse-proxy; injects the server-held homeserver-native token. Ships dark behind app.hs-token.enabled."
  }, {
    "name" : "Self-silence",
    "description" : "Self-service visibility hide (owner = JWT subject). NOT a ban: no role/suspension/revocation."
  }, {
    "name" : "Account status",
    "description" : "Polling endpoint for the caller's own account status (roles, domain, silence)."
  }, {
    "name" : "Notifications (in-app floor)",
    "description" : "The caller's OWN in-app notifications (owner = JWT subject, domain-scoped). The always-on in-app channel — read + mark-read only; the actions reconciler writes them."
  }, {
    "name" : "Connected clients",
    "description" : "The caller's OWN connected apps + device sessions (owner = JWT subject). Requires an external-client role."
  }, {
    "name" : "Notifications (internal deliver)",
    "description" : "SERVICE-PRINCIPAL ONLY in-app notification delivery (target taken from the body). Honours prefs (account-restriction forced-on) and is idempotent on the source event."
  } ],
  "paths" : {
