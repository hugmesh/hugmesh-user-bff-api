                  "items" : {
                    "$ref" : "#/components/schemas/UserModuleCard"
                  }
                }
              }
            }
          }
        }
      },
      "put" : {
        "tags" : [ "Cards" ],
        "summary" : "Publish (create/update) a card bundle for a slug.",
        "description" : "Body is the single entry file (octet-stream). federation-api content-hashes it, records a user_modules row under ME (forwarded JWT), and supersedes the prior version.",
        "operationId" : "put_2",
        "parameters" : [ {
          "name" : "slug",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "pattern" : "^[a-z0-9](?:[a-z0-9-]{0,126}[a-z0-9])?$"
          }
        }, {
          "name" : "entryFile",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "string",
            "maxLength" : 512,
            "minLength" : 0
          }
        }, {
          "name" : "visibility",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "string",
            "pattern" : "^(public|internal)$"
          }
        }, {
          "name" : "manifest",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/octet-stream" : {
              "schema" : {
                "type" : "string",
                "format" : "byte"
              }
            }
          }
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/UserModuleCard"
                }
              }
            }
          }
        }
      },
      "delete" : {
        "tags" : [ "Cards" ],
        "summary" : "Delete one of my cards by slug.",
        "description" : "Proxies federation-api's owner-scoped DELETE: removes the caller's OWN current bundle for the slug (federation-api removes the storage version + supersedes the row). Owner-enforced upstream via the forwarded JWT (a non-owner gets 404 from federation-api).",
        "operationId" : "delete_1",
        "parameters" : [ {
          "name" : "slug",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "pattern" : "^[a-z0-9](?:[a-z0-9-]{0,126}[a-z0-9])?$"
          }
        } ],
        "responses" : {
          "204" : {
            "description" : "No Content"
          }
        }
      }
