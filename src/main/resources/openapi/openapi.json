    "/bff/user/cards/{slug}" : {
      "get" : {
        "tags" : [ "Cards" ],
        "summary" : "List versions of one of my cards by slug.",
        "operationId" : "bySlug",
        "parameters" : [ {
          "name" : "slug",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "pattern" : "^[a-z0-9](?:[a-z0-9-]{0,126}[a-z0-9])?$"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
